func ({{.Recv}} *{{.Struct}}) NbtSet(path nbtpath.Path, v any) (int, error) {
	snap := {{.Recv}}.MetaSnapshot()
	m, err := nbtpath.MarshalToValue({{.Recv}})
	if err != nil {
		return 0, err
	}
	n, err := nbtpath.Set(m, path, v)
	if err != nil {
		return 0, err
	}
	if err := nbtpath.WriteBack({{.Recv}}, m); err != nil {
		return 0, err
	}
	{{.Recv}}.MetaDiffMark(snap)
	return n, nil
}

