func ({{.Recv}} *{{.Struct}}) NbtMerge(src map[string]any) (int, error) {
	snap := {{.Recv}}.MetaSnapshot()
	m, err := nbtpath.MarshalToValue({{.Recv}})
	if err != nil {
		return 0, err
	}
	root, ok := m.(map[string]any)
	if !ok {
		return 0, nbtpath.ErrNotACompound
	}
	n, err := nbtpath.MergeRoot(root, src)
	if err != nil {
		return 0, err
	}
	if err := nbtpath.WriteBack({{.Recv}}, root); err != nil {
