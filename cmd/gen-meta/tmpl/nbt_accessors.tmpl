func ({{.Recv}} *{{.Struct}}) NbtRoot() (any, error) {
	return nbtpath.MarshalToValue({{.Recv}})
}

func ({{.Recv}} *{{.Struct}}) NbtGet(path nbtpath.Path) (any, error) {
	root, err := nbtpath.MarshalToValue({{.Recv}})
	if err != nil {
		return nil, err
	}
	anchors, err := nbtpath.Resolve(root, path)
	if err != nil {
		return nil, err
	}
	if len(anchors) == 0 {
		return nil, nbtpath.ErrPathNotFound
	}
	return anchors[0].Value(), nil
}

